.md-editor {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ed;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  border-bottom: 1rpx solid #eee;
  background: #f8f9fa;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #909399;
  position: relative;
}

.mode-tab-active {
  color: #4A90F3;
  font-weight: 600;
}

.mode-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #4A90F3;
  border-radius: 2rpx;
}

/* 工具栏 */
.toolbar {
  white-space: nowrap;
  border-bottom: 1rpx solid #eee;
  background: #f8f9fa;
}

.toolbar-inner {
  display: inline-flex;
  padding: 12rpx 16rpx;
  gap: 8rpx;
}

.toolbar-btn {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #555;
  background: #fff;
  border: 1rpx solid #e4e7ed;
  border-radius: 8rpx;
  white-space: nowrap;
}

.toolbar-btn:active {
  background: #e8f0fe;
  color: #4A90F3;
  border-color: #4A90F3;
}

/* 编辑区 */
.editor-textarea {
  width: 100%;
  min-height: 400rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  box-sizing: border-box;
}

/* 字数统计 */
.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #c0c4cc;
  padding: 8rpx 24rpx 16rpx;
}

/* 预览区 */
.preview-area {
  min-height: 400rpx;
  padding: 24rpx;
}

.preview-empty {
  text-align: center;
  color: #c0c4cc;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.preview-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}
