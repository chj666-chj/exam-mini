page { background-color: #f0f2f5; }
.page-entry { width: 100%; min-height: 100vh; padding-bottom: 40rpx; }

.subject-card {
  background: linear-gradient(135deg, #4A90F3, #5b9bf5);
  padding: 40rpx 30rpx;
  color: #fff;
}
.subject-name { font-size: 36rpx; font-weight: 600; }
.subject-meta { font-size: 26rpx; opacity: 0.85; margin-top: 10rpx; }

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-text { color: #999; font-size: 28rpx; }
.error-text { color: #e64340; font-size: 28rpx; margin-bottom: 20rpx; }
.empty-text { color: #999; font-size: 28rpx; }
.retry-btn {
  margin-top: 20rpx;
  padding: 16rpx 60rpx;
  display: flex; align-items: center; justify-content: center;
  background: #4A90F3;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.section { margin: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }

.mode-grid { display: flex; gap: 20rpx; }
.mode-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 4rpx solid #e8e8e8;
  background: #fafafa;
}
.mode-card.active { border-color: #4A90F3; background: #e6f1fb; }
.mode-badge {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600; color: #fff; margin-right: 20rpx;
  flex-shrink: 0;
}
.answer-badge { background: #4A90F3; }
.memorize-badge { background: #1bcfad; }
.mode-info { flex: 1; }
.mode-name { font-size: 28rpx; font-weight: 600; color: #333; }
.mode-desc { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.tag-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag {
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #666;
}
.tag-active { background: #4A90F3; color: #fff; }

.btn-area { padding: 40rpx 30rpx; }
.btn-start {
  background: #4A90F3;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  height: 88rpx;
}
.btn-start::after { border: none; }
