.page-rank {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 30rpx;
}

/* ===== 蓝色头部 ===== */
.rank-header {
  background: linear-gradient(180deg, #5b9bf5, #4a90f3);
  padding: 30rpx 30rpx 50rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.seg-pill {
  display: flex;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  overflow: hidden;
  width: 380rpx;
  margin: 0 auto;
}

.seg {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  padding: 14rpx 0;
}

.seg-on {
  background: #fff;
  color: #4a90f3;
  font-weight: 600;
}

.header-score {
  text-align: center;
  color: #fff;
  margin-top: 40rpx;
}

.score-num {
  font-size: 72rpx;
  font-weight: 600;
}

.score-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ===== 统计卡片 ===== */
.stats-card,
.week-card,
.board-card {
  background: #fff;
  border-radius: 16rpx;
  margin: -30rpx 24rpx 24rpx;
  position: relative;
  padding: 30rpx 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 33.33%;
  text-align: center;
  padding: 20rpx 0;
}

.cell-num {
  font-size: 40rpx;
  color: #333;
  font-weight: 600;
}

.cell-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ===== 本周达标 ===== */
.week-card {
  margin-top: 0;
}

.week-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.week-main {
  font-size: 30rpx;
  color: #333;
}

.week-num {
  color: #4a90f3;
}

.week-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.week-legend {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-on {
  background: #4a90f3;
}

.dot-off {
  border: 3rpx solid #f56c6c;
  width: 10rpx;
  height: 10rpx;
}

.week-line {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  position: relative;
  padding: 0 20rpx;
}

.day-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.node {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.node-on {
  background: #4a90f3;
  box-shadow: 0 0 0 6rpx rgba(74, 144, 243, 0.2);
}

.node-off {
  background: #f0f2f5;
  border: 3rpx dashed #c0c4cc;
}

.day-label {
  font-size: 22rpx;
  color: #999;
}

/* ===== 排行榜 ===== */
.board-row {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.board-row:last-child {
  border-bottom: none;
}

.board-row.head {
  color: #999;
  font-size: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.board-row.me {
  background: rgba(74, 144, 243, 0.06);
}

.col-rank {
  width: 90rpx;
  text-align: center;
}

.col-user {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.nick {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-num {
  width: 130rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.rank-no {
  font-size: 28rpx;
  color: #666;
}

.rank-no.top1 {
  color: #f7b500;
  font-weight: 700;
}

.rank-no.top2 {
  color: #909399;
  font-weight: 700;
}

.rank-no.top3 {
  color: #c0703c;
  font-weight: 700;
}
