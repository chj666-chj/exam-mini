page { background-color: #f0f2f5; }
.note { min-height: 100vh; padding-bottom: 140rpx; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.state-text { color: #999; font-size: 28rpx; }
.state-text.error { color: #e64340; }
.empty-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #e8f8f0; margin-bottom: 30rpx;
  border: 8rpx solid #1bcfad;
}
.empty-text { font-size: 32rpx; color: #333; font-weight: 500; }
.empty-sub { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.empty-btn {
  margin-top: 40rpx; padding: 20rpx 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: #4A90F3; color: #fff;
  border-radius: 44rpx; font-size: 28rpx;
}

/* 进度条 */
.progress-bar { background: #fff; padding: 24rpx 30rpx; }
.progress-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.progress-label { font-size: 24rpx; color: #e64340; background: #fde8e8; padding: 6rpx 20rpx; border-radius: 20rpx; }
.progress-count { font-size: 28rpx; color: #333; font-weight: 600; }

/* 已掌握状态条 */
.resolved-banner {
  margin: 16rpx 20rpx 0;
  padding: 16rpx 24rpx;
  background: #e8f8f0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #1bcfad;
  text-align: center;
}

/* 题目卡片 */
.question-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }

.question-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.question-type {
  display: inline-block; font-size: 22rpx; color: #4A90F3;
  background: #e6f1fb; padding: 6rpx 20rpx; border-radius: 20rpx;
}
.resolved-tag {
  font-size: 22rpx; color: #1bcfad; background: #e8f8f0;
  padding: 6rpx 20rpx; border-radius: 20rpx;
}

.question-title { font-size: 32rpx; color: #333; line-height: 1.6; margin-bottom: 16rpx; }

/* 答案对比 */
.answer-compare {
  background: #fff8e8; border-radius: 10rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx;
}
.compare-row { display: flex; align-items: center; }
.compare-label { font-size: 26rpx; color: #999; }
.compare-value { font-size: 26rpx; font-weight: 600; }
.compare-value.wrong { color: #e64340; }

.review-hint { font-size: 24rpx; color: #1bcfad; margin-bottom: 24rpx; }

/* 选项 */
.question-options { display: flex; flex-direction: column; gap: 16rpx; }
.option-item {
  display: flex; align-items: center;
  padding: 24rpx; border-radius: 12rpx;
  background: #f8f9fb; border: 2rpx solid transparent;
}
.option-item.correct { background: #e8f8f0; border-color: #1bcfad; }
.option-item.wrong { background: #fde8e8; border-color: #e64340; }
.option-item.retry-selected { background: #e6f1fb; border-color: #4A90F3; }

.option-marker { margin-right: 20rpx; flex-shrink: 0; }
.marker-circle {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 4rpx solid #ccc; background: transparent;
}
.marker-correct { border-color: #1bcfad; background: #1bcfad; }
.marker-wrong { border-color: #e64340; background: #e64340; }
.marker-retry { border-color: #4A90F3; background: #4A90F3; }

.option-content { flex: 1; font-size: 28rpx; color: #333; line-height: 1.5; }
.answer-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; margin-left: 12rpx; }
.correct-tag { color: #1bcfad; background: #fff; }
.wrong-tag { color: #e64340; background: #fff; }

/* 重做模式 */
.retry-hint {
  padding: 16rpx 20rpx;
  background: #e6f1fb;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #4A90F3;
  margin-bottom: 20rpx;
}
.retry-result {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.retry-ok { color: #1bcfad; background: #e8f8f0; }
.retry-fail { color: #e64340; background: #fde8e8; }
.retry-submit-btn {
  margin-top: 24rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx;
  background: #4A90F3;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

/* 操作按钮区 */
.note-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.note-act-btn {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  padding: 18rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: 2rpx solid #e4e7ed;
  background: #f5f7fa;
  color: #666;
}
.retry-btn.active {
  background: #e6f1fb;
  color: #4A90F3;
  border-color: #4A90F3;
}
.resolved-btn.resolved-on {
  background: #e8f8f0;
  color: #1bcfad;
  border-color: #1bcfad;
}

/* 导航栏 */
.nav-bar {
  display: flex; gap: 20rpx; padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.nav-btn { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24rpx; border-radius: 44rpx; font-size: 30rpx; font-weight: 500; }
.nav-prev { background: #f0f2f5; color: #666; }
.nav-next { background: #4A90F3; color: #fff; }
.nav-btn.disabled { opacity: 0.4; }

/* 小屏适配 */
@media (max-width: 320px) {
  .question-title { font-size: 30rpx; }
  .option-content { font-size: 26rpx; }
  .note-act-btn { font-size: 24rpx; padding: 16rpx; }
}
