.page-ai-config {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 列表头 */
.config-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.config-list-title {
  font-size: 28rpx;
  color: #606266;
  font-weight: 500;
}

.config-add-btn {
  padding: 12rpx 32rpx;
  display: flex; align-items: center; justify-content: center;
  background: #4A90F3;
  color: #fff;
  font-size: 26rpx;
  border-radius: 8rpx;
}

/* 空状态 */
.config-empty {
  text-align: center;
  padding: 120rpx 0;
}

.config-empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.config-empty-text {
  font-size: 26rpx;
  color: #909399;
}

/* 配置卡片 */
.config-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  border: 2rpx solid transparent;
}

.config-card-selected {
  border-color: #4A90F3;
  box-shadow: 0 0 12rpx rgba(74, 144, 243, 0.2);
}

.config-selected-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #4A90F3;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 12rpx 0 12rpx;
}

.config-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.config-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.config-actions {
  display: flex;
  gap: 16rpx;
}

.config-action-btn {
  font-size: 24rpx;
  color: #4A90F3;
  padding: 6rpx 16rpx;
  border: 1rpx solid #4A90F3;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.config-action-danger {
  color: #f56c6c;
  border-color: #f56c6c;
}

.config-card-body {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.config-info-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.config-info-label {
  font-size: 24rpx;
  color: #909399;
  width: 80rpx;
  flex-shrink: 0;
}

.config-info-value {
  font-size: 24rpx;
  color: #606266;
  flex: 1;
  word-break: break-all;
}

.config-info-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.config-select-btn {
  margin-top: 16rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 14rpx 0;
  background: #e8f0fe;
  color: #4A90F3;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.config-select-btn:active {
  background: #d0e0fc;
}

/* 弹窗 */
.form-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-modal {
  width: 88%;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.form-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-modal-field {
  margin-bottom: 20rpx;
}

.form-modal-label {
  font-size: 26rpx;
  color: #606266;
  display: block;
  margin-bottom: 10rpx;
}

.required {
  color: #f56c6c;
}

.form-modal-input {
  width: 100%;
  height: 72rpx;
  font-size: 26rpx;
  padding: 0 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #dcdfe6;
  box-sizing: border-box;
}

.form-modal-textarea {
  width: 100%;
  min-height: 100rpx;
  font-size: 26rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #dcdfe6;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.form-modal-btn {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.form-modal-cancel {
  background: #f8f9fa;
  color: #606266;
  border: 1rpx solid #dcdfe6;
}

.form-modal-confirm {
  background: #4A90F3;
  color: #fff;
}

/* 说明面板 */
.config-notice {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #4A90F3;
}

.config-notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.config-notice-line {
  font-size: 23rpx;
  color: #909399;
  line-height: 1.7;
}

/* 作用域 / 状态标签 */
.config-scope-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: 400;
}

.scope-global {
  background: #eef2f7;
  color: #606266;
}

.scope-user {
  background: #e8f0fe;
  color: #4A90F3;
}

.config-disabled-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  background: #f4f4f5;
  color: #909399;
  font-weight: 400;
}

.config-selected-tag-global {
  background: #e6a23c;
}

/* 调用顺序 */
.config-order {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.config-order-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.config-order-item {
  font-size: 23rpx;
  color: #909399;
  line-height: 1.8;
}

/* 表单：选择器 / 开关行 */
.form-modal-picker {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  padding: 0 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #dcdfe6;
  box-sizing: border-box;
  color: #606266;
}

.form-modal-field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-modal-field-row .form-modal-label {
  margin-bottom: 0;
}
