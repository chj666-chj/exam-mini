<view class="page-score">
  <!-- 蓝色弧形背景 -->
  <view class="score-hero">
    <view class="hero-curve"></view>
  </view>

  <!-- 白色卡片（头像悬浮其上） -->
  <view class="score-card">
    <view class="avatar-wrap">
      <image class="score-avatar" src="{{avatar}}" mode="aspectFill" />
    </view>
    <view class="user-name">{{nickname}}</view>

    <view class="score-main">
      <view class="score-value">{{score}}<text class="score-unit">分</text></view>
      <view class="score-caption">考试成绩</view>
    </view>

    <view class="score-stats">
      <view class="sstat">
        <view class="sstat-num">{{useTime}}</view>
        <view class="sstat-label">考试用时</view>
      </view>
      <view class="sstat">
        <view class="sstat-num">{{resultText}}</view>
        <view class="sstat-label">考试结果</view>
      </view>
      <view class="sstat">
        <view class="sstat-num">{{accuracy}}%</view>
        <view class="sstat-label">正确率</view>
      </view>
      <view class="sstat">
        <view class="sstat-num">{{rank}}</view>
        <view class="sstat-label">考试排名</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="btn-area">
    <button class="btn btn-primary" bindtap="bindgoview">查看答案</button>
    <button class="btn btn-plain" open-type="share">分享成绩</button>
  </view>
</view>
