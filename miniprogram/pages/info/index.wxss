/* ===== 登录注册页面 ===== */
.auth-page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 0 48rpx 60rpx;
  box-sizing: border-box;
}

/* ===== Logo 区 ===== */
.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: 40rpx;
}

.auth-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid var(--c-primary-light);
  background: #eee;
}

.auth-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-top: 24rpx;
}

.auth-subtitle {
  font-size: 26rpx;
  color: var(--c-text-muted);
  margin-top: 10rpx;
}

/* ===== Tab 切换 ===== */
.auth-tabs {
  display: flex;
  background: var(--c-bg-white);
  border-radius: var(--r-md);
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.auth-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--c-text-muted);
  position: relative;
  transition: all 0.2s;
}

.auth-tab-active {
  color: var(--c-primary);
  font-weight: 600;
}

.auth-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--c-primary);
}

/* ===== 全局错误 ===== */
.auth-global-error {
  display: flex;
  align-items: center;
  background: var(--c-danger-light);
  border-radius: var(--r-sm);
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.auth-global-error-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--c-danger);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 700;
}

.auth-global-error-text {
  font-size: 26rpx;
  color: var(--c-danger);
  flex: 1;
}

/* ===== 表单 ===== */
.auth-form {
  background: var(--c-bg-white);
  border-radius: var(--r-lg);
  padding: 40rpx 36rpx;
  box-shadow: var(--shadow-md);
}

/* ===== 表单字段 ===== */
.form-field {
  display: flex;
  align-items: center;
  background: var(--c-bg-gray);
  border-radius: var(--r-md);
  border: 2rpx solid transparent;
  padding: 0 24rpx;
  height: 88rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s;
}

.form-field-error {
  border-color: var(--c-danger);
  background: var(--c-danger-light);
}

.field-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.form-field-error .field-icon {
  background: var(--c-danger-light);
  color: var(--c-danger);
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--c-text);
  height: 88rpx;
}

.field-placeholder {
  color: var(--c-text-light);
  font-size: 28rpx;
}

.field-toggle {
  font-size: 24rpx;
  color: var(--c-primary);
  padding: 10rpx 8rpx;
  flex-shrink: 0;
}

/* ===== 字段错误文字 ===== */
.field-error-msg {
  font-size: 24rpx;
  color: var(--c-danger);
  padding: 4rpx 24rpx 16rpx;
}

/* ===== 提交按钮 ===== */
.auth-submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--c-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--r-md);
  margin-top: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-submit-btn[disabled] {
  opacity: 0.6;
}

/* ===== 切换链接 ===== */
.auth-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--c-text-muted);
}

.auth-switch-link {
  color: var(--c-primary);
  margin-left: 8rpx;
  font-weight: 500;
}

/* ===== 忘记密码 ===== */
.auth-forgot-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.auth-forgot-link {
  font-size: 26rpx;
  color: var(--c-text-muted);
  padding: 8rpx 4rpx;
}

/* ===== 分割线 ===== */
.auth-divider {
  display: flex;
  align-items: center;
  margin: 36rpx 0 24rpx;
  gap: 20rpx;
}

.auth-divider-line {
  flex: 1;
  height: 2rpx;
  background: var(--c-border);
}

.auth-divider-text {
  font-size: 24rpx;
  color: var(--c-text-light);
}

/* ===== 游客按钮 ===== */
.auth-guest-btn {
  width: 100%;
  height: 84rpx;
  background: var(--c-bg-white);
  color: var(--c-text-secondary);
  font-size: 28rpx;
  border-radius: var(--r-md);
  border: 2rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-guest-btn[disabled] {
  opacity: 0.5;
}
