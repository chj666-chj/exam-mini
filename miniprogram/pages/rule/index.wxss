.page-rule{
    background-color: #f0f0f0;
    width: 100%;
    height: 100%;
}
.page-rule .title{
    height: 50px;
    line-height: 50px;
    vertical-align: middle;
    background-color: #fff;
    padding-left: 10px;
}

.page-rule .content{
    border-top: 1px solid #f0f0f0;
    background-color: #fff;
    padding-left: 10px;
    width: 97%;
    min-height: 250px;
}
.page-rule .item{
    padding-top: 8px;
    padding-bottom: 8px;
    padding-right: 10px;
    font-size: 14px;
    min-height: 45px;
    line-height: 1.7;
    color: #333;
    border-bottom: 1px solid #f5f5f5;
}
.page-rule .loading-tip {
    text-align: center;
    color: #999;
    padding: 60rpx 0;
}
/* 外层组件的宽度可设置成100%或具体数值 */
.page-rule .adContainer {
    margin-top: 10px;
    padding-bottom: 10px;
    width: 100%;
}
