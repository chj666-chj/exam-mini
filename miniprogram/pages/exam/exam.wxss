page { background-color: #f0f2f5; }
.exam { min-height: 100vh; padding-bottom: 140rpx; }

.state-box { display: flex; justify-content: center; align-items: center; padding: 200rpx 0; }
.state-text { color: #999; font-size: 28rpx; }
.state-text.error { color: #e64340; }

/* ===== 模拟考试倒计时 ===== */
.exam-timer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #4A90F3;
  padding: 20rpx 30rpx;
  color: #fff;
}
.timer-icon-text { font-size: 26rpx; opacity: 0.9; }
.timer-text { font-size: 36rpx; font-weight: 600; font-family: monospace; }
.exam-timer.timer-warning { background: #e64340; animation: timer-pulse 1s infinite; }
@keyframes timer-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.7; } }

/* ===== 进度条 ===== */
.progress-bar { background: #fff; padding: 24rpx 30rpx 16rpx; }
.progress-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.progress-label { font-size: 24rpx; color: #4A90F3; background: #e6f1fb; padding: 6rpx 20rpx; border-radius: 20rpx; }
.progress-count { font-size: 28rpx; color: #333; font-weight: 600; }

/* 自定义进度条：CSS transition 实现增量平滑动画 */
.progress-track {
  height: 12rpx;
  background: #e8e8e8;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #4A90F3;
  border-radius: 6rpx;
  /* 关键：transition 仅对 width 做增量动画（从当前值到新值），
     而非内置 progress active 每次从 0 重新动画 */
  transition: width 0.3s ease;
  -webkit-transition: width 0.3s ease;
}

/* ===== 题目卡片 ===== */
.question-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }

/* ===== 功能7: 题目标签 ===== */
.question-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.qtag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.qtag-type { color: #4A90F3; background: #e6f1fb; }
.qtag-diff-1 { color: #1bcfad; background: #e8f8f0; }
.qtag-diff-2 { color: #d4a017; background: #fff8e8; }
.qtag-diff-3 { color: #e64340; background: #fde8e8; }
.qtag-img { color: #8b5cf6; background: #f3e8ff; }
.qtag-spacer { flex: 1; }

/* ===== 功能2: 收藏按钮 ===== */
.fav-btn {
  font-size: 22rpx;
  color: #999;
  background: #f5f7fa;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e4e7ed;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav-btn.fav-on {
  color: #f5a623;
  background: #fff8e8;
  border-color: #f5a623;
}

/* ===== 题干与配图 ===== */
.question-title { font-size: 32rpx; color: #333; line-height: 1.6; margin-bottom: 20rpx; }

.question-image-box { margin-bottom: 20rpx; }
.image-placeholder {
  background: #f5f7fa;
  border: 2rpx dashed #c0c4cc;
  border-radius: 12rpx;
  padding: 40rpx 20rpx;
  text-align: center;
}
.image-label { display: block; font-size: 22rpx; color: #8b5cf6; margin-bottom: 8rpx; }
.image-desc { display: block; font-size: 24rpx; color: #999; line-height: 1.4; }

/* ===== 选项 ===== */
.question-options { display: flex; flex-direction: column; gap: 16rpx; }
.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f8f9fb;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.option-item.selected { background: #e6f1fb; border-color: #4A90F3; }
.option-item.correct { background: #e8f8f0; border-color: #1bcfad; }
.option-item.wrong { background: #fde8e8; border-color: #e64340; }

.option-marker { margin-right: 20rpx; flex-shrink: 0; }
.marker-circle {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 4rpx solid #ccc;
  background: transparent;
}
.marker-filled { border-color: #4A90F3; background: #4A90F3; }
.marker-correct { border-color: #1bcfad; background: #1bcfad; }

.option-content { flex: 1; font-size: 28rpx; color: #333; line-height: 1.5; }
.answer-tag { font-size: 20rpx; color: #1bcfad; background: #fff; padding: 4rpx 12rpx; border-radius: 8rpx; margin-left: 12rpx; }

/* ===== 即时反馈 ===== */
.instant-result {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.result-correct { color: #1bcfad; background: #e8f8f0; }
.result-wrong { color: #e64340; background: #fde8e8; }

.memorize-hint {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #fff8e8;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #d4a017;
}

/* ===== 功能1: 解析 ===== */
.explanation-section { margin-top: 24rpx; }
.explanation-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4A90F3;
}
.explanation-toggle-text { font-weight: 500; }
.explanation-toggle-arrow { font-size: 24rpx; }
.explanation-content {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
}
.explanation-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e4e7ed;
}
.exp-tag-label { font-size: 22rpx; color: #999; }
.exp-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #e6f1fb;
  color: #4A90F3;
}
.explanation-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

/* ===== 回答结果信息块 ===== */
.answer-result-block {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  border: 2rpx solid #e4e7ed;
}
.result-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.result-label { font-size: 24rpx; color: #999; }
.result-value { font-size: 26rpx; color: #333; font-weight: 500; }
.result-value.result-right { color: #1bcfad; }
.result-value.result-wrong { color: #e64340; }
.result-correct-text { color: #1bcfad; }
.result-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}
.result-badge.result-right { background: #e8f8f0; color: #1bcfad; }
.result-badge.result-wrong { background: #fde8e8; color: #e64340; }

/* ===== 功能6: 反馈 ===== */
.feedback-section { margin-top: 20rpx; }
.feedback-form { margin-top: 0; }
.feedback-input {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  font-size: 26rpx;
  background: #f8f9fb;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.5;
}
.feedback-submit {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  background: #4A90F3;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

/* ===== 底部操作栏（5按钮） ===== */
.nav-bar {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 50;
}
.nav-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}
.nav-secondary { background: #f0f2f5; color: #666; }
.nav-secondary.nav-active { background: #e6f1fb; color: #4A90F3; border: 2rpx solid #4A90F3; }
.nav-primary { background: #4A90F3; color: #fff; }
.nav-btn.disabled { opacity: 0.4; }

/* ===== 功能3: 答题卡弹层 ===== */
.card-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-panel {
  width: 88%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  max-height: 70vh;
  overflow-y: auto;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title { font-size: 32rpx; font-weight: 600; color: #333; }
.card-close { font-size: 40rpx; color: #999; padding: 0 12rpx; }

.card-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.card-stat-item { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: #666; }
.card-stat-dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.dot-answered { background: #4A90F3; }
.dot-unanswered { background: #e4e7ed; }
.dot-correct { background: #1bcfad; }
.dot-wrong { background: #e64340; }

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.card-cell {
  position: relative;
  overflow: hidden;          /* 裁掉右下角状态角标的溢出部分，配合圆角 */
  box-sizing: border-box;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: background-color .15s ease, color .15s ease, border-color .15s ease;
}
/* ===== 作答状态配色（第一识别标识：正确=绿 / 错误=红 / 已答=蓝 / 未答=灰）===== */
.cell-unanswered { background: #f5f7fa; color: #999;    border-color: #e4e7ed; }
.cell-answered  { background: #e6f1fb; color: #4A90F3; border-color: #4A90F3; }
.cell-correct   { background: #e8f8f0; color: #1bcfad; border-color: #1bcfad; }
.cell-wrong     { background: #fde8e8; color: #e64340; border-color: #e64340; }
/* 当前题：改用蓝色描边环。若仍用实心蓝底，会盖掉正确/错误配色，
   导致「当前这道题看不出答对还是答错」——这正是要避免的标识冲突。 */
.cell-current { box-shadow: 0 0 0 4rpx rgba(74, 144, 243, 0.45); }

/* ===== 第二识别标识：角标（✓ / ✗）=====
   颜色之外再给一层形状提示，便于快速扫读，也对色弱用户更友好 */
.cell-mark {
  position: absolute;
  top: 2rpx;
  right: 5rpx;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
}
.cell-correct .cell-mark { color: #1bcfad; }
.cell-wrong .cell-mark { color: #e64340; }
/* 右下角状态小三角（纯色块，一眼扫读时最先被感知） */
.cell-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
}
.cell-correct .cell-corner { border-bottom: 16rpx solid #1bcfad; }
.cell-wrong .cell-corner { border-bottom: 16rpx solid #e64340; }

/* ===== 字体大小偏好 ===== */
.fs-small .question-title { font-size: 28rpx; }
.fs-small .option-content { font-size: 24rpx; }
.fs-medium .question-title { font-size: 32rpx; }
.fs-medium .option-content { font-size: 28rpx; }
.fs-large .question-title { font-size: 36rpx; }
.fs-large .option-content { font-size: 32rpx; }

/* ===== 小屏适配 ===== */
@media (max-width: 320px) {
  .question-title { font-size: 30rpx; }
  .option-content { font-size: 26rpx; }
  .card-cell { width: 60rpx; height: 60rpx; font-size: 26rpx; }
  .cell-mark { font-size: 16rpx; top: 1rpx; right: 3rpx; }
  .cell-corner { border-left-width: 14rpx; }
  .cell-correct .cell-corner { border-bottom-width: 14rpx; }
  .cell-wrong .cell-corner { border-bottom-width: 14rpx; }
  .qtag { font-size: 20rpx; padding: 4rpx 14rpx; }
  .fav-btn { font-size: 20rpx; padding: 4rpx 14rpx; }
  .nav-btn { font-size: 22rpx; padding: 16rpx 0; }
  .ai-btn-text { font-size: 22rpx; }
  .ai-section-title { font-size: 22rpx; }
  .ai-section-body { font-size: 22rpx; }
}

/* ===== AI 题目深度解析（VIP 专用）===== */
.ai-analysis-entry { margin-top: 20rpx; }
.ai-analysis-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s;
}
.ai-btn-vip {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.ai-btn-locked {
  background: #f5f7fa;
  color: #999;
  border: 2rpx solid #e4e7ed;
}
.ai-btn-icon {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.25);
}
.ai-btn-locked .ai-btn-icon {
  background: #e4e7ed;
  color: #bbb;
}
.ai-btn-text { flex: 1; text-align: center; }
.ai-btn-lock-icon { font-size: 24rpx; }

/* AI 解析结果面板 */
.ai-analysis-panel {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  border: 2rpx solid #e4e7ed;
  max-height: 800rpx;
  overflow-y: auto;
}

/* 元信息行 */
.ai-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.ai-cached-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #1bcfad;
  background: #e8f8f0;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}
.ai-meta-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #4A90F3;
  background: #e6f1fb;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.ai-section { margin-bottom: 20rpx; }
.ai-section:last-child { margin-bottom: 0; }
.ai-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #4A90F3;
  margin-bottom: 10rpx;
}

/* 标签列表（知识点 / 核心概念 / 推荐标签）*/
.ai-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.ai-kp-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: #e6f1fb;
  color: #4A90F3;
}
.ai-concept-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: #f3e8ff;
  color: #8b5cf6;
}
.ai-suggest-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  color: #666;
  border: 2rpx solid #e4e7ed;
}

/* 常见错误列表 */
.ai-mistake-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ai-mistake-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.ai-mistake-bullet {
  color: #e64340;
  font-size: 28rpx;
  line-height: 1.5;
  flex-shrink: 0;
}
.ai-mistake-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
  flex: 1;
}

/* Markdown 渲染区域（scroll-view + rich-text）*/
.ai-md-scroll {
  max-height: 500rpx;
  padding: 12rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 2rpx solid #e4e7ed;
}
.ai-md-content { font-size: 26rpx; color: #333; line-height: 1.7; }

/* ===== Markdown rich-text 样式（与 ai-report 页一致）===== */
.ai-md-content .md-h1, .ai-summary-md .md-h1 { font-size: 32rpx; font-weight: 700; color: #303133; margin: 12rpx 0; }
.ai-md-content .md-h2, .ai-summary-md .md-h2 { font-size: 30rpx; font-weight: 700; color: #303133; margin: 10rpx 0; }
.ai-md-content .md-h3, .ai-summary-md .md-h3 { font-size: 28rpx; font-weight: 600; color: #303133; margin: 10rpx 0; }
.ai-md-content .md-p, .ai-summary-md .md-p { font-size: 26rpx; color: #333; line-height: 1.7; margin: 6rpx 0; }
.ai-md-content .md-ul, .ai-summary-md .md-ul { padding-left: 32rpx; margin: 6rpx 0; }
.ai-md-content .md-ol, .ai-summary-md .md-ol { padding-left: 32rpx; margin: 6rpx 0; }
.ai-md-content .md-li, .ai-summary-md .md-li { font-size: 26rpx; color: #333; line-height: 1.7; }
.ai-md-content .md-quote, .ai-summary-md .md-quote { border-left: 6rpx solid #4A90F3; padding-left: 16rpx; color: #606266; font-size: 24rpx; margin: 8rpx 0; }
.ai-md-content .md-inline-code, .ai-summary-md .md-inline-code { background: #f0f2f5; color: #d63384; padding: 0 6rpx; border-radius: 4rpx; font-size: 24rpx; }
.ai-md-content .md-code-block, .ai-summary-md .md-code-block { background: #282c34; color: #abb2bf; padding: 16rpx; border-radius: 8rpx; font-size: 24rpx; margin: 8rpx 0; }
.ai-md-content .md-img, .ai-summary-md .md-img { max-width: 100%; }
.ai-md-content .md-table, .ai-summary-md .md-table { border-collapse: collapse; width: 100%; margin: 8rpx 0; }
.ai-md-content .md-th, .ai-summary-md .md-th { border: 2rpx solid #dcdfe6; padding: 6rpx 10rpx; font-size: 22rpx; background: #f5f7fa; font-weight: 600; }
.ai-md-content .md-td, .ai-summary-md .md-td { border: 2rpx solid #dcdfe6; padding: 6rpx 10rpx; font-size: 22rpx; }
.ai-md-content strong, .ai-summary-md strong { font-weight: 700; color: #303133; }
.ai-md-content em, .ai-summary-md em { font-style: italic; color: #555; }

/* AI 状态盒子（加载 / 错误 / 空）*/
.ai-state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  gap: 16rpx;
}
.ai-state-text { font-size: 26rpx; color: #999; }
.ai-text-error { color: #e64340; }
.ai-state-error { padding: 30rpx 20rpx; }
.ai-retry-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #4A90F3;
  padding: 10rpx 32rpx;
  border: 2rpx solid #4A90F3;
  border-radius: 30rpx;
}

/* AI 加载动画 */
.ai-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e4e7ed;
  border-top-color: #4A90F3;
  border-radius: 50%;
  animation: ai-spin 0.8s linear infinite;
}
@keyframes ai-spin { to { transform: rotate(360deg); } }

/* ===== 答题卡内 AI 分析入口 ===== */
.card-ai-summary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 40rpx;
}
.card-ai-summary-btn.card-ai-locked {
  background: #f5f7fa;
  color: #999;
  border: 2rpx solid #e4e7ed;
}
.card-ai-icon {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.25);
}
.card-ai-locked .card-ai-icon { background: #e4e7ed; color: #bbb; }
.card-ai-lock { font-size: 24rpx; }

/* ===== AI 答题分析总结弹层 ===== */
.ai-summary-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-summary-panel {
  width: 90%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.ai-summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.ai-summary-title { font-size: 32rpx; font-weight: 600; color: #333; }
.ai-summary-close { font-size: 40rpx; color: #999; padding: 0 12rpx; }
.ai-summary-body { flex: 1; max-height: 60vh; padding: 30rpx; }
.ai-summary-content { }
.ai-summary-overall {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
}
.ai-summary-score-bar {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
  padding: 20rpx 0;
  background: #f8f9fb;
  border-radius: 12rpx;
}
.ai-score-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.ai-score-num { font-size: 40rpx; font-weight: 700; }
.ai-score-label { font-size: 22rpx; color: #999; }
.ai-score-correct { color: #1bcfad; }
.ai-score-wrong { color: #e64340; }
.ai-score-skip { color: #999; }
.ai-score-total { color: #4A90F3; }
.ai-summary-md {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
}

/* ===== VIP 升级引导弹层 ===== */
.vip-upgrade-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vip-upgrade-panel {
  position: relative;
  width: 80%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.vip-upgrade-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 40rpx;
  color: #999;
  padding: 0 12rpx;
}
.vip-upgrade-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #f5a623 0%, #e64340 100%);
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
}
.vip-upgrade-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  text-align: center;
}
.vip-upgrade-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  text-align: center;
  margin-bottom: 32rpx;
  white-space: pre-wrap;
}
.vip-upgrade-action {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 44rpx;
}
