<view class="pe-page">
  <!-- 头像区 -->
  <view class="pe-avatar-area" bindtap="chooseAvatar">
    <image class="pe-avatar" src="{{avatarUrl || '/images/header.png'}}" mode="aspectFill" />
    <view class="pe-avatar-tip">点击更换头像</view>
  </view>

  <!-- 全局错误 -->
  <view wx:if="{{globalError}}" class="pe-global-error">
    <text>{{globalError}}</text>
  </view>

  <!-- 表单 -->
  <view class="pe-form">
    <!-- 用户名（只读） -->
    <view class="pe-field">
      <text class="pe-label">用户名</text>
      <input class="pe-input" value="{{account}}" disabled="true" placeholder="未设置" />
    </view>

    <!-- 昵称 -->
    <view class="pe-field {{errors.nickname ? 'pe-field-error' : ''}}">
      <text class="pe-label">昵称</text>
      <input class="pe-input" value="{{nickname}}" placeholder="请输入昵称" maxlength="20" bindinput="onNicknameInput" />
    </view>
    <view wx:if="{{errors.nickname}}" class="pe-error-msg">{{errors.nickname}}</view>

    <!-- 邮箱 -->
    <view class="pe-field {{errors.email ? 'pe-field-error' : ''}}">
      <text class="pe-label">邮箱</text>
      <input class="pe-input" value="{{email}}" placeholder="请输入邮箱（用于找回密码）" type="text" bindinput="onEmailInput" />
    </view>
    <view wx:if="{{errors.email}}" class="pe-error-msg">{{errors.email}}</view>

    <!-- 手机号 -->
    <view class="pe-field {{errors.phone ? 'pe-field-error' : ''}}">
      <text class="pe-label">手机号</text>
      <input class="pe-input" value="{{phone}}" placeholder="请输入手机号（用于找回密码）" type="number" maxlength="11" bindinput="onPhoneInput" />
    </view>
    <view wx:if="{{errors.phone}}" class="pe-error-msg">{{errors.phone}}</view>

    <!-- 地址 -->
    <view class="pe-field {{errors.address ? 'pe-field-error' : ''}}">
      <text class="pe-label">地址</text>
      <input class="pe-input" value="{{address}}" placeholder="请输入地址（选填）" maxlength="200" bindinput="onAddressInput" />
    </view>
    <view wx:if="{{errors.address}}" class="pe-error-msg">{{errors.address}}</view>

    <!-- 注册时间（只读） -->
    <view class="pe-field" wx:if="{{createdAt}}">
      <text class="pe-label">注册时间</text>
      <input class="pe-input" value="{{createdAt}}" disabled="true" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <button class="pe-save-btn" bindtap="handleSave" loading="{{saving}}" disabled="{{saving}}">
    {{saving ? '保存中...' : '保存'}}
  </button>
</view>
