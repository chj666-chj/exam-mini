.page-create {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 表单区块 */
.form-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.required {
  color: #f56c6c;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
  padding: 0 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 100rpx;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-thumb {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f56c6c;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border: 2rpx dashed #dcdfe6;
  border-radius: 10rpx;
  color: #909399;
}

.image-add-icon {
  font-size: 48rpx;
  color: #c0c4cc;
  line-height: 1;
}

.image-add-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #e8f0fe;
  color: #4A90F3;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.tag-remove {
  font-size: 28rpx;
  color: #c0c4cc;
  margin-left: 4rpx;
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.tag-add-btn {
  padding: 12rpx 28rpx;
  display: flex; align-items: center; justify-content: center;
  background: #4A90F3;
  color: #fff;
  font-size: 26rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* AI 辅助按钮 */
.ai-section {
  margin-bottom: 16rpx;
}

.ai-config-select {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.ai-config-label {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 12rpx;
}

.ai-config-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  color: #c0c4cc;
  font-size: 28rpx;
}

.ai-no-config {
  text-align: center;
  font-size: 24rpx;
  color: #4A90F3;
  padding: 16rpx 0;
}

.ai-btn {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #67c23a, #5daf34);
  border-radius: 12rpx;
  border: none;
}

.ai-btn-loading {
  background: #a0c77f;
  opacity: 0.8;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 16rpx;
}

/* AI 取消按钮 */
.ai-cancel-btn {
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
  color: #909399;
  padding: 12rpx 0;
  margin-top: 8rpx;
}

.ai-cancel-btn:active {
  color: #f56c6c;
}

/* 提交按钮 */
.submit-section {
  margin-top: 8rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
}
