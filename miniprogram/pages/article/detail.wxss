.page-article {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

/* 标题 */
.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

/* 元信息 */
.detail-meta {
  font-size: 22rpx;
  color: #b0b0b0;
  margin: 20rpx 0 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-author {
  color: #4A90F3;
}

.meta-dot {
  margin: 0 8rpx;
  color: #ddd;
}

/* 收藏按钮 */
.detail-fav-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: auto;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  transition: all 0.2s;
}

.detail-fav-btn.fav-on {
  color: #e8a317;
  background: #fff8e8;
}

.detail-fav-star {
  font-size: 28rpx;
  line-height: 1;
}

.detail-fav-text {
  font-size: 22rpx;
}

/* 标签 */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.detail-tag {
  font-size: 22rpx;
  color: #4A90F3;
  background: #e8f0fe;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 图片轮播 */
.detail-swiper {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

/* 摘要 */
.detail-summary {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  margin-bottom: 24rpx;
  border-left: 4rpx solid #4A90F3;
}

/* 正文 */
.detail-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}

/* ---- Markdown 富文本样式 ---- */

/* 标题 */
.detail-content .md-h1 {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin: 24rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #eee;
}

.detail-content .md-h2 {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin: 20rpx 0 12rpx;
}

.detail-content .md-h3 {
  font-size: 28rpx;
  font-weight: 600;
  color: #444;
  margin: 16rpx 0 10rpx;
}

/* 段落 */
.detail-content .md-p {
  margin: 12rpx 0;
  line-height: 1.8;
}

/* 图片 */
.detail-content .md-img {
  max-width: 100%;
  border-radius: 8rpx;
  margin: 12rpx 0;
}

/* 引用 */
.detail-content .md-quote {
  border-left: 6rpx solid #4A90F3;
  background: #f8f9fa;
  padding: 16rpx 20rpx;
  margin: 16rpx 0;
  color: #666;
  font-size: 26rpx;
}

/* 行内代码 */
.detail-content .md-inline-code {
  background: #f0f0f0;
  color: #e6a23c;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 26rpx;
  font-family: monospace;
}

/* 代码块 */
.detail-content .md-code-block {
  background: #1e1e1e;
  color: #d4d4d4;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  overflow-x: auto;
  margin: 16rpx 0;
}

/* 列表 */
.detail-content .md-ul,
.detail-content .md-ol {
  padding-left: 40rpx;
  margin: 12rpx 0;
}

.detail-content .md-li {
  margin: 6rpx 0;
  line-height: 1.7;
}

/* 表格 */
.detail-content .md-table {
  width: 100%;
  border-collapse: collapse;
  margin: 16rpx 0;
  font-size: 26rpx;
}

.detail-content .md-th {
  background: #f5f7fa;
  font-weight: 600;
  padding: 10rpx 16rpx;
  border: 2rpx solid #e4e7ed;
  text-align: left;
}

.detail-content .md-td {
  padding: 10rpx 16rpx;
  border: 2rpx solid #e4e7ed;
}

/* 链接 */
.detail-content a {
  color: #4A90F3;
}
