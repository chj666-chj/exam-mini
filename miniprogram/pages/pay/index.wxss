.activation-page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

/* 头部 */
.activation-header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}
.activation-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.activation-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.activation-desc {
  font-size: 26rpx;
  color: #999;
}

/* VIP 状态卡片 */
.vip-status-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 0;
}
.vip-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.vip-info {
  flex: 1;
}
.vip-label {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.vip-expire {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

/* 激活码输入区 */
.code-input-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 20rpx 0;
}
.renew-hint {
  font-size: 26rpx;
  color: #4A90F3;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 6 格输入 */
.code-digits {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  position: relative;
}
.digit-box {
  width: 90rpx;
  height: 100rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  background: #fafafa;
  transition: all 0.2s;
}
.digit-box.active {
  border-color: #4A90F3;
  background: #f0f6ff;
}
.digit-box.filled {
  border-color: #4A90F3;
  background: #fff;
}

/* 隐藏 input */
.hidden-input {
  position: absolute;
  left: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
}

/* 操作按钮 */
.code-actions {
  display: flex;
  gap: 20rpx;
}
.btn-clear {
  flex: 1;
  height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}
.btn-activate {
  flex: 2;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90F3, #3578e8);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
.btn-activate[disabled] {
  background: #a0c4f5;
  color: rgba(255, 255, 255, 0.7);
}
.btn-clear[disabled] {
  background: #f0f0f0;
  color: #ccc;
}

/* 结果提示 */
.result-msg {
  padding: 24rpx 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  margin: 10rpx 0;
}
.result-msg.success {
  background: #f0fff4;
  color: #1bcfad;
  border: 2rpx solid #d4f5e8;
}
.result-msg.error {
  background: #fff0f0;
  color: #e64340;
  border: 2rpx solid #ffd6d6;
}

/* 底部说明 */
.activation-footer {
  margin-top: 40rpx;
  padding: 20rpx;
}
.footer-item {
  font-size: 24rpx;
  color: #aaa;
  line-height: 1.8;
}

/* 返回首页 */
.go-home-link {
  text-align: center;
  color: #4A90F3;
  font-size: 28rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}
