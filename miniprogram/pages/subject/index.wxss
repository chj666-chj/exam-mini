page { background-color: #f0f2f5; }
.page-subjects { min-height: 100vh; }

.header-card {
  background: linear-gradient(135deg, #4A90F3, #5b9bf5);
  padding: 40rpx 30rpx;
  color: #fff;
}
.header-title { font-size: 32rpx; font-weight: 600; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.state-text { color: #999; font-size: 28rpx; }
.state-text.error { color: #e64340; margin-bottom: 20rpx; }
.retry-btn {
  padding: 16rpx 60rpx;
  display: flex; align-items: center; justify-content: center;
  background: #4A90F3; color: #fff;
  border-radius: 30rpx; font-size: 26rpx;
}

.subject-list { padding: 20rpx; }
.subject-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 16rpx;
}
.subject-num {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #4A90F3; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600; margin-right: 24rpx;
  flex-shrink: 0;
}
.subject-name { flex: 1; font-size: 30rpx; color: #333; }
.subject-arrow { color: #ccc; font-size: 28rpx; }
