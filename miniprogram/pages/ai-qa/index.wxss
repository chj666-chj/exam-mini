.page-ai-qa {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f2f5;
  box-sizing: border-box;
}

/* 顶部说明 */
.qa-header {
  background: linear-gradient(135deg, #4A90F3 0%, #5BA0FF 100%);
  padding: 28rpx 32rpx;
  flex-shrink: 0;
}

.qa-header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.qa-header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 消息滚动区 */
.chat-scroll {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.chat-bottom-space {
  height: 24rpx;
}

/* 推荐问题 */
.recommend-area {
  margin-bottom: 24rpx;
}

.recommend-title {
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 16rpx;
}

.recommend-item {
  background: #fff;
  color: #4A90F3;
  font-size: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid #e3edfd;
}

.recommend-item:active {
  background: #e8f0fe;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-ai {
  justify-content: flex-start;
}

/* 气泡 */
.msg-bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-bubble-user {
  background: #4A90F3;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-bubble-ai {
  background: #fff;
  color: #303133;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-loading {
  font-size: 26rpx;
  color: #909399;
}

/* 来源标签 */
.msg-sources {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f2f5;
}

.msg-sources-label {
  font-size: 22rpx;
  color: #909399;
}

.msg-source-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  font-size: 22rpx;
  color: #4A90F3;
  background: #e8f0fe;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin: 4rpx 10rpx 0 0;
}

.msg-source-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
  background: #4A90F3;
  border-radius: 4rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.msg-source-title {
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.msg-source-code {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #909399;
  margin-left: 8rpx;
}

/* 文章来源使用橙色区分，并可点击跳转文章详情 */
.msg-source-article {
  background: #fdf6ec;
  color: #d48806;
}

.msg-source-article .msg-source-type {
  background: #E6A23C;
}

.msg-source-article .msg-source-code {
  color: #b88230;
}

/* 底部输入栏 */
.chat-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e9edf2;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #303133;
}

.chat-send-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 36rpx;
  background: #4A90F3;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.chat-send-btn:active {
  background: #3a7fd8;
}

.chat-send-disabled {
  opacity: 0.6;
}

/* ===== Markdown 渲染样式（rich-text nodes class） ===== */
.md-h1 { font-size: 34rpx; font-weight: 700; color: #303133; margin: 14rpx 0; }
.md-h2 { font-size: 31rpx; font-weight: 700; color: #303133; margin: 14rpx 0; }
.md-h3 { font-size: 29rpx; font-weight: 600; color: #303133; margin: 12rpx 0; }
.md-p { font-size: 28rpx; color: #303133; line-height: 1.7; margin: 8rpx 0; }
.md-ul, .md-ol { padding-left: 32rpx; margin: 8rpx 0; }
.md-li { font-size: 28rpx; color: #303133; line-height: 1.7; }
.md-quote { border-left: 6rpx solid #4A90F3; padding-left: 16rpx; color: #606266; font-size: 26rpx; margin: 10rpx 0; }
.md-inline-code { background: #f0f2f5; color: #d63384; padding: 0 6rpx; border-radius: 4rpx; font-size: 26rpx; }
.md-code-block { background: #282c34; color: #abb2bf; padding: 16rpx; border-radius: 8rpx; font-size: 24rpx; margin: 10rpx 0; }
.md-img { max-width: 100%; }
.md-table { border-collapse: collapse; width: 100%; margin: 10rpx 0; }
.md-th { border: 1rpx solid #dcdfe6; padding: 6rpx 10rpx; font-size: 24rpx; background: #f5f7fa; font-weight: 600; }
.md-td { border: 1rpx solid #dcdfe6; padding: 6rpx 10rpx; font-size: 24rpx; }

/* 顶部模型选择 */
.qa-model-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.qa-model-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-right: 12rpx;
}

.qa-model-picker {
  display: inline-block;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: #4A90F3;
  background: #fff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.qa-model-empty {
  font-size: 24rpx;
  color: #fff;
  text-decoration: underline;
}
