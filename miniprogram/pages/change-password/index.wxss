.cp-page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 强制改密提示 ===== */
.cp-force-tip {
  background: var(--c-warning-light);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  margin: 24rpx 0;
  font-size: 26rpx;
  color: var(--c-warning);
  line-height: 1.5;
}

/* ===== 全局错误 ===== */
.cp-global-error {
  background: var(--c-danger-light);
  border-radius: var(--r-sm);
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--c-danger);
}

/* ===== 表单 ===== */
.cp-form {
  background: var(--c-bg-white);
  border-radius: var(--r-lg);
  padding: 12rpx 36rpx;
  box-shadow: var(--shadow-sm);
}

.cp-field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-border-light);
}

.cp-field:last-child {
  border-bottom: none;
}

.cp-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--c-text-secondary);
  flex-shrink: 0;
}

.cp-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--c-text);
}

.cp-toggle {
  font-size: 24rpx;
  color: var(--c-primary);
  padding: 10rpx 8rpx;
  flex-shrink: 0;
}

.cp-error-msg {
  font-size: 24rpx;
  color: var(--c-danger);
  padding: 4rpx 0 8rpx 160rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}

/* ===== 密码强度 ===== */
.cp-strength {
  display: flex;
  align-items: center;
  padding: 12rpx 0 12rpx 160rpx;
  border-bottom: 1rpx solid var(--c-border-light);
  gap: 16rpx;
}

.cp-strength-bar {
  flex: 1;
  height: 8rpx;
  background: var(--c-bg-gray);
  border-radius: 4rpx;
  overflow: hidden;
}

.cp-strength-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.cp-strength-1 { width: 25%; background: var(--c-danger); }
.cp-strength-2 { width: 50%; background: var(--c-warning); }
.cp-strength-3 { width: 75%; background: var(--c-success); }
.cp-strength-4 { width: 100%; background: var(--c-primary); }

.cp-strength-text {
  font-size: 22rpx;
  color: var(--c-text-muted);
  flex-shrink: 0;
}

/* ===== 提交按钮 ===== */
.cp-submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--c-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--r-md);
  margin-top: 36rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cp-submit-btn[disabled] {
  opacity: 0.6;
}
