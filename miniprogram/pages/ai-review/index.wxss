.page-ai-review {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 统计卡片 */
.stat-card {
  background: linear-gradient(135deg, #4A90F3 0%, #5BA0FF 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 243, 0.3);
}

.stat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.stat-date {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.stat-date-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-body {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.stat-progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.stat-progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 生成按钮 */
.gen-btn-area {
  margin-bottom: 24rpx;
}

.gen-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  background: #fff;
  color: #4A90F3;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 2rpx solid #4A90F3;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 243, 0.15);
}

.gen-btn:active {
  background: #e8f0fe;
}

.gen-btn-disabled {
  opacity: 0.7;
}

.gen-progress-bar {
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.gen-progress-fill {
  height: 100%;
  background: #4A90F3;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.gen-status-text {
  text-align: center;
  font-size: 24rpx;
  color: #909399;
  margin-top: 10rpx;
}

/* 复习清单 */
.review-section {
  margin-bottom: 20rpx;
}

.review-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.review-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}

.review-item:active {
  background: #f8f9fa;
}

.review-item-done {
  opacity: 0.6;
}

.review-item-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8f0fe;
  color: #4A90F3;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.review-item-content {
  flex: 1;
  min-width: 0;
}

.review-item-summary {
  font-size: 28rpx;
  color: #303133;
  line-height: 1.5;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.review-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  line-height: 1.5;
}

.review-tag-primary {
  background: #e8f0fe;
  color: #4A90F3;
}

.review-tag-success {
  background: #e8f7ec;
  color: #67c23a;
}

.review-tag-danger {
  background: #fef0f0;
  color: #f56c6c;
}

.review-count {
  font-size: 22rpx;
  color: #909399;
}

.review-item-status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.review-done-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #67c23a;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-arrow {
  font-size: 36rpx;
  color: #c0c4cc;
  line-height: 1;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #606266;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #909399;
}
