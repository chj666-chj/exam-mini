page { background-color: #f0f2f5; }
.page-question { min-height: 100vh; padding-bottom: 120rpx; }

.state-box { display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 200rpx 0; }
.state-text { color: #999; font-size: 28rpx; }
.state-text.error { color: #e64340; }

/* 全部已答完 */
.all-done-box { padding: 240rpx 60rpx; }
.all-done-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #e8f8f0; color: #1bcfad;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; margin-bottom: 30rpx;
}
.all-done-title { font-size: 34rpx; color: #333; font-weight: 500; margin-bottom: 12rpx; }
.all-done-desc { font-size: 26rpx; color: #999; text-align: center; margin-bottom: 40rpx; }
.all-done-btn {
  padding: 20rpx 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: #4A90F3;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  margin-bottom: 16rpx;
}
.header-title { font-size: 28rpx; color: #4A90F3; }
.header-count { font-size: 26rpx; color: #999; }

/* 未作习题过滤信息条 */
.undone-info-bar {
  margin: 0 20rpx 16rpx;
  padding: 16rpx 24rpx;
  background: #e6f1fb;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #4A90F3;
}

.question-list { padding: 0 20rpx; }
.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.question-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.question-num {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #4A90F3; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600;
}
.question-type-tag {
  font-size: 22rpx; color: #4A90F3; background: #e6f1fb;
  padding: 6rpx 16rpx; border-radius: 16rpx;
}
.question-title { font-size: 30rpx; color: #333; line-height: 1.6; margin-bottom: 24rpx; }

.options-list { display: flex; flex-direction: column; gap: 12rpx; }
.option-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #f8f9fb;
  border: 2rpx solid transparent;
}
.option-row.opt-selected { background: #e6f1fb; border-color: #4A90F3; }
.option-row.opt-correct { background: #e8f8f0; border-color: #1bcfad; }
.option-row.opt-wrong { background: #fde8e8; border-color: #e64340; }

.opt-marker {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 4rpx solid #ccc; margin-right: 16rpx; flex-shrink: 0;
}
.opt-marker.marker-on { border-color: #4A90F3; background: #4A90F3; }
.opt-marker.marker-correct { border-color: #1bcfad; background: #1bcfad; }

.opt-text { flex: 1; font-size: 28rpx; color: #333; line-height: 1.5; }
.opt-answer-tag { font-size: 20rpx; color: #1bcfad; margin-left: 12rpx; }

.submit-bar { padding: 20rpx 30rpx 60rpx; }
.btn-submit {
  background: #4A90F3; color: #fff;
  border-radius: 44rpx; font-size: 32rpx;
  height: 88rpx;
}
.btn-submit::after { border: none; }

/* 小屏适配 */
@media (max-width: 320px) {
  .question-title { font-size: 28rpx; }
  .opt-text { font-size: 26rpx; }
  .undone-info-bar { font-size: 22rpx; }
  .all-done-title { font-size: 30rpx; }
}
