.fp-page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
}

/* ===== Header ===== */
.fp-header {
  padding: 48rpx 0 36rpx;
}

.fp-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--c-text);
}

.fp-subtitle {
  font-size: 26rpx;
  color: var(--c-text-muted);
  margin-top: 10rpx;
}

/* ===== 全局错误 ===== */
.fp-global-error {
  background: var(--c-danger-light);
  border-radius: var(--r-sm);
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--c-danger);
}

/* ===== 表单 ===== */
.fp-form {
  background: var(--c-bg-white);
  border-radius: var(--r-lg);
  padding: 24rpx 36rpx;
  box-shadow: var(--shadow-sm);
}

.fp-field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-border-light);
}

.fp-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--c-text-secondary);
  flex-shrink: 0;
}

.fp-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--c-text);
}

.fp-error-msg {
  font-size: 24rpx;
  color: var(--c-danger);
  padding: 4rpx 0 8rpx 160rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}

/* ===== 渠道选择 ===== */
.fp-channel-label {
  font-size: 28rpx;
  color: var(--c-text-secondary);
  padding: 24rpx 0 16rpx;
}

.fp-channel-group {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.fp-channel-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--c-text-secondary);
  background: var(--c-bg-gray);
  border-radius: var(--r-md);
  border: 2rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fp-channel-active {
  color: #fff;
  background: var(--c-primary);
  border-color: var(--c-primary);
}

/* ===== 开发环境验证码 ===== */
.fp-dev-code {
  background: var(--c-warning-light);
  border-radius: var(--r-sm);
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--c-warning);
  display: flex;
  align-items: center;
}

.fp-dev-code-val {
  font-weight: 700;
  font-size: 32rpx;
  margin-left: 8rpx;
}

.fp-target-hint {
  font-size: 24rpx;
  color: var(--c-text-muted);
  padding: 8rpx 0 16rpx;
}

/* ===== 提交按钮 ===== */
.fp-submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--c-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--r-md);
  margin-top: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fp-submit-btn[disabled] {
  opacity: 0.6;
}

/* ===== 返回链接 ===== */
.fp-back {
  text-align: center;
  font-size: 26rpx;
  color: var(--c-text-muted);
  padding: 24rpx 0 8rpx;
}
