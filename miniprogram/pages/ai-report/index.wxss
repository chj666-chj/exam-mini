.page-ai-report {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* Tab */
.report-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.report-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #606266;
  padding: 16rpx 0;
  border-radius: 10rpx;
}

.report-tab-active {
  background: #4A90F3;
  color: #fff;
  font-weight: 600;
}

/* 生成按钮 */
.gen-btn-area {
  margin-bottom: 20rpx;
}

.gen-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  background: #fff;
  color: #4A90F3;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 2rpx solid #4A90F3;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 243, 0.15);
}

.gen-btn:active {
  background: #e8f0fe;
}

.gen-btn-disabled {
  opacity: 0.7;
}

/* ===== 生成中面板：加载动画 + 思考过程 ===== */
.generating-panel {
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.gen-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* CSS 旋转加载动画（纯 CSS，无图片依赖） */
.gen-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4A90F3;
  border-radius: 50%;
  animation: gen-spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes gen-spin {
  to { transform: rotate(360deg); }
}

.gen-loading-text {
  font-size: 28rpx;
  color: #606266;
}

/* 思考过程区域 */
.thinking-area {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef1f5;
}

.thinking-header {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 16rpx;
}

.thinking-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.thinking-step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.thinking-dot-done {
  background: #4A90F3;
}

.thinking-dot-active {
  background: #4A90F3;
  animation: thinking-pulse 1.2s ease-in-out infinite;
}

@keyframes thinking-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.3); }
}

.thinking-step-text {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.5;
  flex: 1;
}

/* 报告摘要卡片 */
.report-summary-card {
  background: linear-gradient(135deg, #4A90F3, #5b9bf5);
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 243, 0.2);
}

.report-summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.report-summary-text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
  font-weight: 500;
}

/* 报告卡片 */
.report-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.report-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.report-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A90F3;
}

.report-card-time {
  font-size: 22rpx;
  color: #909399;
}

/* 通用 Section 卡片 */
.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* 亮点 */
.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #f0f9ff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #d9ecff;
}

.highlight-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 26rpx;
  color: #303133;
  line-height: 1.6;
  flex: 1;
}

/* 建议 */
.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #fef9f0;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #fdf0d5;
}

.suggestion-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.suggestion-text {
  font-size: 26rpx;
  color: #303133;
  line-height: 1.6;
  flex: 1;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #606266;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #909399;
}

/* ===== Markdown 渲染样式（rich-text nodes class） ===== */
.md-h1 { font-size: 34rpx; font-weight: 700; color: #303133; margin: 14rpx 0; }
.md-h2 { font-size: 31rpx; font-weight: 700; color: #303133; margin: 14rpx 0; }
.md-h3 { font-size: 29rpx; font-weight: 600; color: #303133; margin: 12rpx 0; }
.md-p { font-size: 28rpx; color: #303133; line-height: 1.7; margin: 8rpx 0; }
.md-ul, .md-ol { padding-left: 32rpx; margin: 8rpx 0; }
.md-li { font-size: 28rpx; color: #303133; line-height: 1.7; }
.md-quote { border-left: 6rpx solid #4A90F3; padding-left: 16rpx; color: #606266; font-size: 26rpx; margin: 10rpx 0; }
.md-inline-code { background: #f0f2f5; color: #d63384; padding: 0 6rpx; border-radius: 4rpx; font-size: 26rpx; }
.md-code-block { background: #282c34; color: #abb2bf; padding: 16rpx; border-radius: 8rpx; font-size: 24rpx; margin: 10rpx 0; }
.md-img { max-width: 100%; }
.md-table { border-collapse: collapse; width: 100%; margin: 10rpx 0; }
.md-th { border: 1rpx solid #dcdfe6; padding: 6rpx 10rpx; font-size: 24rpx; background: #f5f7fa; font-weight: 600; }
.md-td { border: 1rpx solid #dcdfe6; padding: 6rpx 10rpx; font-size: 24rpx; }
