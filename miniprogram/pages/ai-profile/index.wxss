.page-ai-profile {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 生成按钮 */
.gen-btn-area {
  margin-bottom: 20rpx;
}

.gen-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  background: #fff;
  color: #4A90F3;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 2rpx solid #4A90F3;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 243, 0.15);
}

.gen-btn:active {
  background: #e8f0fe;
}

.gen-btn-disabled {
  opacity: 0.7;
}

.gen-progress-bar {
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.gen-progress-fill {
  height: 100%;
  background: #4A90F3;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.gen-status-text {
  text-align: center;
  font-size: 24rpx;
  color: #909399;
  margin-top: 10rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #606266;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #909399;
}

/* 概览统计 */
.overview-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90F3 0%, #5BA0FF 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 243, 0.3);
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.overview-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.overview-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 通用 Section 卡片 */
.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* Canvas */
.chart-canvas {
  display: block;
  margin: 0 auto;
}

/* 薄弱知识点 */
.weak-item {
  background: #fef9f0;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #fdf0d5;
}

.weak-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.weak-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  flex: 1;
}

.weak-acc {
  font-size: 28rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.weak-acc-low {
  color: #f56c6c;
  background: #fef0f0;
}

.weak-acc-medium {
  color: #e6a23c;
  background: #fdf6ec;
}

.weak-meta {
  margin-bottom: 8rpx;
}

.weak-total {
  font-size: 22rpx;
  color: #909399;
}

.weak-rec {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  background: #fff;
  border-radius: 6rpx;
  padding: 10rpx 12rpx;
  margin-top: 8rpx;
}

.weak-rec-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.weak-rec-text {
  font-size: 24rpx;
  color: #606266;
  line-height: 1.5;
  flex: 1;
}

/* 错误模式 */
.error-item {
  background: #fef0f0;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #fde2e2;
}

.error-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.error-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}

.error-freq {
  font-size: 22rpx;
  color: #f56c6c;
  background: #fff;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.error-desc {
  font-size: 24rpx;
  color: #606266;
  line-height: 1.5;
  margin-top: 10rpx;
}

/* 定向练习 */
.practice-item {
  display: flex;
  align-items: center;
  background: #f0f9ff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #d9ecff;
}

.practice-item:active {
  background: #e1f0ff;
}

.practice-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.practice-content {
  flex: 1;
  min-width: 0;
}

.practice-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 6rpx;
}

.practice-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.practice-type {
  font-size: 22rpx;
  color: #4A90F3;
  background: #fff;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.practice-count {
  font-size: 22rpx;
  color: #909399;
}

.practice-arrow {
  font-size: 36rpx;
  color: #c0c4cc;
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}
