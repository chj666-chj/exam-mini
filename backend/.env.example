# 考试宝后端环境变量配置（部署时必须设置）
# 本地开发无需配置，所有变量有默认值

# ---- Django 安全配置 ----
# 生产环境必须替换为随机字符串（至少 50 字符）
EXAM_SECRET_KEY=django-insecure-exam-mini-local-dev-only-change-me

# 生产环境设为 False
EXAM_DEBUG=True

# 允许访问的域名列表（逗号分隔），生产环境替换为实际域名
EXAM_ALLOWED_HOSTS=*

# ---- 缓存配置 ----
# 生产环境配置 Redis 连接地址，留空则使用 LocMem
REDIS_URL=

# ---- 管理端配置 ----
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_TOKEN_TTL_HOURS=12

# ---- 小程序端配置 ----
# 写权限校验开关，生产环境保持 True
# EXAM_REQUIRE_OPENID_FOR_WRITE=True

# ---- 数据目录 ----
# 题库数据源目录（默认使用 backend/data/）
# EXAM_DATA_DIR=/path/to/your/data
